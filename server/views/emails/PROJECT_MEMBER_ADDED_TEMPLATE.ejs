<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Added to Project</title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    "
  >
    <div
      style="
        background: linear-gradient(to right, #3b82f6, #2563eb);
        padding: 20px;
        text-align: center;
      "
    >
      <h1 style="color: white; margin: 0">Welcome to the Team! 👋</h1>
    </div>
    <div
      style="
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 0 0 5px 5px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      "
    >
      <p>Hello <strong><%= name %></strong>,</p>
      <p>
        Great news! You have been added as a member to the project
        <strong><%= projectName %></strong> in workspace
        <strong><%= workspaceName %></strong>.
      </p>
      <div style="background-color: #e3f2fd; padding: 15px; border-radius: 5px; margin: 20px 0;">
        <h3 style="margin-top: 0; color: #1976d2;">Project Details</h3>
        <p style="margin: 5px 0;"><strong>Project:</strong> <%= projectName %></p>
        <p style="margin: 5px 0;"><strong>Workspace:</strong> <%= workspaceName %></p>
        <% if (description) { %>
          <p style="margin: 5px 0;"><strong>Description:</strong> <%= description %></p>
        <% } %>
      </div>
      <p>
        You can now start collaborating with your team on this project. Access
        it through your workspace dashboard.
      </p>
      <div style="text-align: center; margin: 30px 0">
        <a
          href="<%= dashboardUrl %>"
          style="
            background-color: #3b82f6;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
          "
          >View Project</a
        >
      </div>
      <p style="color: #666; font-size: 14px; margin-top: 30px;">
        If you have any questions, please contact your workspace administrator.
      </p>
    </div>
  </body>
</html>
